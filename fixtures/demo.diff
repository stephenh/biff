 import type { Review } from "./types";
 
-const PAGE_SIZE = 20;
+const PAGE_SIZE = 50;
 
 /** Find the reviews that still need a human. */
 export function pendingReviews(reviews: Review[]): Review[] {
   return reviews
-    .filter((review) => review.status === "pending")
-    .sort((a, b) => a.createdAt - b.createdAt)
+    .filter((review) => review.status === "pending" && !review.isDraft)
+    .sort((a, b) => b.updatedAt - a.updatedAt)
     .slice(0, PAGE_SIZE);
 }
 
 export function reviewLabel(review: Review): string {
-  return `${review.author}: ${review.title}`;
+  const fileCount = review.files.length;
+  return `${review.title} · ${fileCount} files · by ${review.author}`;
+}
+
+/** Keep the active review visible when its position changes. */
+export function findActiveReview(reviews: Review[], activeId: string): Review | undefined {
+  return reviews.find((review) => review.id === activeId);
 }
