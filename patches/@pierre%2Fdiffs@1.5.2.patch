index 0000000000000000000000000000000000000000..b335da575606bad6aa0e256aa5be2ef608d3b60e
--- /dev/null
+++ b/dist/utils/blockWordDecorations.js
@@ -0,0 +1,74 @@
+import { diffWords } from "diff";
+import { createDiffSpanDecoration } from "./parseDiffDecorations.js";
+
+/**
+ * Compare small, uneven replacement blocks without changing source rows or line pairing.
+ *
+ * Bound extra work per file; blocks outside these budgets retain native line highlights.
+ */
+export function blockWordDecorations(file, maxLineDiffLength = 1000) {
+  const result = { additions: new Map(), deletions: new Map() };
+  const deadline = performance.now() + 20;
+  for (const hunk of file.hunks) {
+    for (const content of hunk.hunkContent) {
+      if (content.type !== "change" || !content.additions || !content.deletions || content.additions === content.deletions) continue;
+      if (performance.now() >= deadline) return result;
+      // Keep the existing line diff for large replacements rather than introducing
+      // unbounded block comparisons into the highlighting path.
+      if (content.additions + content.deletions > 64) continue;
+      const oldLines = file.deletionLines.slice(content.deletionLineIndex, content.deletionLineIndex + content.deletions);
+      const newLines = file.additionLines.slice(content.additionLineIndex, content.additionLineIndex + content.additions);
+      if ([...oldLines, ...newLines].some((line) => line.length > maxLineDiffLength)) continue;
+      const oldSide = createSide(oldLines);
+      const newSide = createSide(newLines);
+      if (oldSide.source.length + newSide.source.length > 8000) continue;
+      const changes = diffWords(oldSide.source, newSide.source, { oneChangePerToken: true, maxEditLength: 256, timeout: 10 });
+      if (!changes || !mapTokens(changes, oldSide, newSide)) continue;
+      oldSide.spans.forEach((spans, line) => result.deletions.set(content.deletionLineIndex + line, spans));
+      newSide.spans.forEach((spans, line) => result.additions.set(content.additionLineIndex + line, spans));
+    }
+  }
+  return result;
+}
+
+/** Feed block results into the same Shiki decorations used by Pierre's native line diff. */
+export function appendBlockWordDecorations(spans, line, decorations) {
+  for (const span of spans) decorations.push(createDiffSpanDecoration({ line, spanStart: span.start, spanLength: span.length }));
+}
+
+/** Keep each side's original whitespace and coordinates independent of jsdiff's common-token text. */
+function createSide(lines) {
+  return { source: lines.join(""), offset: 0, line: 0, column: 0, spans: lines.map(() => []) };
+}
+
+/** jsdiff owns tokenization and matching; only translate its tokens back to each original source. */
+function mapTokens(changes, oldSide, newSide) {
+  for (const change of changes) {
+    const token = change.value.trim();
+    if (!token) continue;
+    if (!change.added && !consumeToken(oldSide, token, change.removed)) return false;
+    if (!change.removed && !consumeToken(newSide, token, change.added)) return false;
+  }
+  return !oldSide.source.slice(oldSide.offset).trim() && !newSide.source.slice(newSide.offset).trim();
+}
+
+/**
+ * Advance over original whitespace, then mark only the changed token's original columns.
+ *
+ * I.e. jsdiff's common ",\n  " token consumes the comma on both sides, but the
+ * old " content" and new "\n  renderedContent" retain different line/column offsets.
+ */
+function consumeToken(side, token, changed) {
+  while (side.offset < side.source.length && /\s/u.test(side.source[side.offset])) {
+    if (side.source[side.offset] === "\n") { side.line++; side.column = 0; }
+    else side.column++;
+    side.offset++;
+  }
+  // If a future jsdiff tokenizer changes its contract, fall back to native line
+  // highlighting for the entire block instead of emitting uncertain coordinates.
+  if (token.includes("\n") || token.includes("\r") || !side.source.startsWith(token, side.offset) || !side.spans[side.line]) return false;
+  if (changed) side.spans[side.line].push({ start: side.column, length: token.length });
+  side.offset += token.length;
+  side.column += token.length;
+  return true;
+}
