+import { createHastElement } from "./hast_utils.js";
+import { createSeparator } from "./createSeparator.js";
+
+// Host folds affect rendered rows, never the source diff's coordinates or tokens.
+export function prepareHostFolds(options, file, renderRange, editing) {
+  const ranges = options.resolveFoldedRanges?.(file) ?? [];
+  if (!ranges.length) return ranges;
+  if ((options.diffStyle ?? "split") !== "unified" || editing) {
+    throw new Error("Host folds require a read-only unified FileDiff");
+  }
+  let end = -1;
+  const ids = new Set();
+  for (const range of ranges) {
+    if (!Number.isInteger(range.start) || !Number.isInteger(range.end) || range.start <= end || range.end < range.start || ids.has(range.id)) {
+      throw new Error("Host folds require sorted, disjoint ranges with unique IDs");
+    }
+    ids.add(range.id);
+    end = range.end;
+  }
+  return ranges;
+}
+
+// Reuse the library's native separator structure and CSS, including gutter width.
+export function pushHostFold(range, context) {
+  for (const column of [context.unifiedGutterAST.children, context.unifiedContentAST]) {
+    const separator = createSeparator({ type: "line-info", content: range.label });
+    separator.properties["data-host-fold"] = range.id;
+    if (!range.expanded) separator.properties["data-host-fold-collapsed"] = "";
+    if (column === context.unifiedContentAST) {
+      separator.children = [];
+      column.push(separator);
+      continue;
+    }
+    const wrapper = separator.children[0];
+    wrapper.properties.style = "display:grid;grid-template-columns:34px auto";
+    const label = wrapper.children[0];
+    label.tagName = "button";
+    label.properties = { ...label.properties, type: "button", "data-fold-toggle": range.id, "aria-expanded": String(range.expanded), "aria-label": range.label, style: "font:inherit;text-align:left;border:0;cursor:pointer;border-top-left-radius:0;border-bottom-left-radius:0" };
+    const icon = createHastElement({ tagName: "button", properties: { type: "button", "data-fold-toggle": range.id, "data-expand-button": "", "aria-expanded": String(range.expanded), "aria-label": `${range.expanded ? "Collapse" : "Expand"} ${range.label}`, style: "font:inherit;border:0;border-right:2px solid var(--diffs-bg);border-radius:6px 0 0 6px" }, children: [{ type: "text", value: range.expanded ? "⌄" : "›" }] });
+    wrapper.children.unshift(icon);
+    column.push(separator);
+  }
+  context.incrementRowCount(1);
+}
